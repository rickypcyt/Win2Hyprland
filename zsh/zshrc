# ============================================================
# zsh en WSL Arch — config ligera (arranca en ~15 ms)
# ============================================================
# ~/.zshrc es un symlink a este archivo:
#   /mnt/c/Users/ricar/Win2Hyprland/zsh/zshrc
# Sin Oh My Zsh: costaba 300-470 ms en cada terminal nueva. Aquí está solo
# lo que se usaba de él (autocompletado, historial, atajos). Oh My Zsh sigue
# en ~/.oh-my-zsh por si se quiere volver.
# ============================================================

# ---------- Historial ----------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ---------- Comportamiento ----------
setopt AUTO_CD              # escribir una carpeta = cd a ella
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# ---------- Autocompletado ----------
# compinit -C usa la caché (~/.zcompdump); se regenera una vez al día.
autoload -Uz compinit
() { if (( $# )); then compinit; else compinit -C; fi } ~/.zcompdump(N.mh+24)
zstyle ':completion:*' menu select                                  # menú navegable con flechas/Tab
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'  # sin distinguir mayúsculas
zstyle ':completion:*' special-dirs true

# ---------- Teclas ----------
bindkey -e                                  # atajos estilo emacs/bash
bindkey '^[[1;5C' forward-word              # Ctrl+→
bindkey '^[[1;5D' backward-word             # Ctrl+←
bindkey '^[[H'  beginning-of-line           # Inicio
bindkey '^[[F'  end-of-line                 # Fin
bindkey '^[[3~' delete-char                 # Supr
bindkey '^H'    backward-kill-word          # Ctrl+Backspace
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search  # ↑ busca en el historial lo ya escrito
bindkey '^[[B' down-line-or-beginning-search

# ---------- Preferencias ----------
export EDITOR=nvim
export VISUAL=nvim
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lhA'
alias grep='grep --color=auto'

# ---------- Colores de ls ----------
# Los archivos de Windows (/mnt/c) se ven como "escribibles por todos" y
# "ejecutables", y ls los pintaba con fondo verde y en verde. Aquí:
#   ow/tw (carpeta escribible por otros) -> carpeta normal: azul, sin fondo
#   ex    (ejecutable)                   -> sin color
eval "$(dircolors -b)"
export LS_COLORS="${LS_COLORS}:ow=01;34:tw=01;34:st=01;34:ex=00"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ---------- Prompt estilo PowerShell ----------
# En carpetas de Windows:  /mnt/c/Users/ricar  ->  C:\Users\ricar>
# En carpetas de Linux:    /home/ricky>  (esas rutas no existen en Windows)
w2h_prompt_path() {
  local p=$PWD
  if [[ $p == /mnt/[a-z] || $p == /mnt/[a-z]/* ]]; then
    local rest=${p:6}
    p="${(U)${p:5:1}}:${rest:-/}"
    p=${p//\//\\}
  fi
  print -r -- "${p//\%/%%}"
}
setopt PROMPT_SUBST
PROMPT='$(w2h_prompt_path)> '
RPROMPT=''

# Título de la pestaña de WezTerm = carpeta actual (como hacía Oh My Zsh)
precmd() { print -Pn "\e]0;%~\a" }
